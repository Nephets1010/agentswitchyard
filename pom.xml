<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    父 POM：Spring Boot 3.5.16 + Spring AI 1.1.8 + Java 21
    - Boot 3.5.16 是 3.5 线最后一个 OSS 补丁版本（OSS 支持已于 2026-06-30 结束，商业支持到 2032-06-30），见 ADR-0005 与 README「支持状态」
    - Spring AI 1.1.8 是 Spring Boot 3.x 对应线（Spring AI 2.0 只能配 Boot 4.x）
    - ★ 首版刻意不引入 LangGraph4j（langgraph4j.version 仅为 P1 适配层预留的版本 property，
      依赖树中不得出现 org.bsc.langgraph4j，由 enforcer + CI 双重把守），见 ADR-0002
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nephets</groupId>
  <artifactId>agentswitchyard</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>agentswitchyard</name>
  <description>Agent Switchyard：LangGraph4j 的可靠性层——审批节点、失败补偿、确定性回放，让长流程 AI 任务可断点续跑、经得起审计</description>
  <url>https://github.com/nephets/agentswitchyard</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nephets</id>
      <name>agentswitchyard maintainers</name>
      <url>https://github.com/nephets</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/nephets/agentswitchyard</url>
    <connection>scm:git:https://github.com/nephets/agentswitchyard.git</connection>
  </scm>

  <modules>
    <module>core</module>
    <module>store</module>
    <module>starter</module>
    <module>mock-llm</module>
    <module>sample</module>
  </modules>

  <!--
    ★ 预先定义一个空的 argLine 属性。
      surefire / failsafe 用 @{argLine} 引用它，jacoco:prepare-agent 在运行期把
      -javaagent:... 注入进来。若不预先定义 argLine，@{argLine} 会保持字面量不被解析，
      导致 jacoco 找不到执行数据 —— 覆盖率报告为空，而 check 规则会因「无数据」静默通过。
  -->
  <properties>
    <argLine></argLine>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- ==== 锁版本：禁止用浮动版本号 ==== -->
    <spring-ai.version>1.1.8</spring-ai.version>
    <!-- ★ P1 适配层才引入（ADR-0002）：仅保留版本 property，pom 中不得出现对应依赖 -->
    <langgraph4j.version>1.8.14</langgraph4j.version>
    <picocli.version>4.7.6</picocli.version>
    <wiremock.version>3.13.2</wiremock.version>
    <assertj.version>3.27.3</assertj.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
    <testcontainers.version>1.21.3</testcontainers.version>

    <spotless.version>3.10.3</spotless.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <jacoco.version>0.8.13</jacoco.version>

    <!-- ==== 覆盖率门禁（架构文档 §8.6）：core ≥ 80%，store ≥ 65%，其余 ≥ 60%，全仓 ≥ 60% ==== -->
    <jacoco.skip>false</jacoco.skip>
    <jacoco.line.minimum>0.60</jacoco.line.minimum>
    <jacoco.line.minimum.core>0.80</jacoco.line.minimum.core>
    <jacoco.line.minimum.store>0.65</jacoco.line.minimum.store>
    <!--
      ★ jacoco 执行数据目录必须是【纯 ASCII 路径】：Windows 上 -javaagent 的 destfile
        参数含非 ASCII 字符时会被截断，jacoco 静默丢数据，check 因「无数据」假通过。
        中文路径仓库请用 -Djacoco.dest.dir=<纯 ASCII 路径> 覆盖，或在 ASCII 路径下构建。
        initialize 阶段的 antrun 会先清掉上一轮残留，保证覆盖率只反映本次构建。
    -->
    <jacoco.dest.dir>C:/Users/Public/swy-jacoco/${project.artifactId}.exec</jacoco.dest.dir>
    <jacoco.report.skip>true</jacoco.report.skip>
    <swy.test.heap>512m</swy.test.heap>
    <swy.failsafe.heap>768m</swy.failsafe.heap>

    <jacoco.coverage>enabled</jacoco.coverage>
    <maven.javadoc.skip>false</maven.javadoc.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 本仓模块 -->
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>agentswitchyard-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>agentswitchyard-store</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>agentswitchyard-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>agentswitchyard-mock-llm</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 三方 -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>mysql</artifactId>
        <version>${testcontainers.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>postgresql</artifactId>
        <version>${testcontainers.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    ★ 刻意不在父 POM 的 <dependencies> 里声明通用依赖：
      若在此声明 spring-boot-starter-test，core 的依赖树就无法用机器判定「零 Spring Boot 依赖」。
      各子模块按需显式声明自己真正用到的依赖。
  -->

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <argLine>@{argLine} -Xmx${swy.test.heap} -Xms64m -XX:+ExitOnOutOfMemoryError</argLine>
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <argLine>@{argLine} -Xmx${swy.failsafe.heap}</argLine>
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        ==== 集成测试（*IT.java，mvn verify 阶段执行）====
        配置在 pluginManagement；这里声明启用（默认绑定 integration-test + verify）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <!--
        ==== 每次构建先清空本模块的 jacoco .exec ====
        jacoco.dest.dir 在项目之外（为绕开中文路径），mvn clean 管不到那里；
        残留 .exec 会污染本轮覆盖率数据。绑在 initialize（早于 prepare-agent）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-stale-jacoco-data</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- failonerror=false：CI 是 Linux 路径，删不存在的文件不该失败 -->
                <delete file="${jacoco.dest.dir}" failonerror="false" quiet="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        ==== 强制 Java 21 与 Maven 版本 + 依赖边界 ====
        bannedDependencies 在父级守住「三仓不互相依赖 / 不引入图引擎 / 不引入 Jackson 3」；
        core 模块在自己的 pom 里追加「零 Spring Boot / 零 Servlet」的更严边界。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>本项目需要 JDK 21（使用虚拟线程）。当前 JAVA_HOME=$(java.home)</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.9,)</version>
                </requireMavenVersion>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <!-- 决策 4：三仓互相不依赖，此处机器化守住 -->
                    <exclude>io.github.nephets:switchyard*</exclude>
                    <exclude>io.github.nephets:glasshouse*</exclude>
                    <!-- ADR-0002：首版不引入 LangGraph4j，P1 适配层才引入 -->
                    <exclude>org.bsc.langgraph4j:*</exclude>
                    <!-- ADR-0005：不预埋 Jackson 3 / Spring AI 2.x -->
                    <exclude>tools.jackson:*</exclude>
                  </excludes>
                  <message>禁止引入另两个 LLM 基建仓库或 LangGraph4j / Jackson 3，理由见 ADR-0002 / ADR-0005</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ==== 统一代码格式：google-java-format AOSP，CI 用 check 阻断 ==== -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>com,io,org,javax,java,\#</order>
            </importOrder>
          </java>
          <formats>
            <format>
              <includes>
                <include>*.md</include>
                <include>docs/**/*.md</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
      </plugin>

      <!--
        ==== 覆盖率：report + check 在 verify 阶段强制 ====
        阈值用 ${jacoco.line.minimum}，core/store 模块在自己的 pom 里覆写该属性
        （0.80 / 0.65）。父 pom（packaging=pom）无执行数据，report.skip 显式跳过。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dest.dir}</destFile>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <!-- 集成测试数据追加到同一文件：省掉 merge，消除 fileSets 缺失类构建故障 -->
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dest.dir}</destFile>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.dest.dir}</dataFile>
              <formats>
                <format>HTML</format>
                <format>XML</format>
                <format>CSV</format>
              </formats>
            </configuration>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <dataFile>${jacoco.dest.dir}</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- 跨模块覆盖率汇总报告：mvn -Pcoverage verify 后看 target/site/jacoco-aggregate/index.html -->
  <profiles>
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>aggregate-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
