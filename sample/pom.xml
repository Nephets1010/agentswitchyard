<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>agentswitchyard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agentswitchyard-sample</artifactId>
  <name>agentswitchyard-sample</name>
  <description>信贷审批助手 demo：AI 初筛 → 风险打分 → 规则引擎 → 人工审批 → 放款，含补偿动作与工具治理示例</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>agentswitchyard-spring-boot-starter</artifactId>
    </dependency>
    <!--
      LLM 接入走 Spring AI 官方 openai starter（mock-llm 就是 OpenAI 兼容端点）。
      换真实模型只需改 base-url / api-key 配置，不改业务代码。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <!-- compose demo 用 PostgreSQL 跑生产级方言；H2 仅用于零依赖本地体验 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.nephets.agentswitchyard.sample.SampleApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
